
# Coupon System - Example Configuration
# Copy to application.properties for local development.
# Never commit application.properties with credentials.

# Database
spring.datasource.url=jdbc:postgresql://localhost:55432/coupons_local
spring.datasource.username=YOUR_DATABASE_USERNAME
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=true

# Profile
spring.profiles.active=development

# Database connection pool
spring.datasource.hikari.validation-timeout=5000
spring.datasource.hikari.connection-timeout=30000

# JWT
# Supply COUPONS_JWT_SECRET_BASE64 through the environment.
# The secret must contain at least 32 random bytes, Base64-encoded.

# CORS
# Supply COUPONS_ALLOWED_ORIGINS through the environment
# when the frontend uses a different origin.

# Public demo deployment only:
#
# Set the following environment variables in RunMyDocker:
#
# COUPONS_PUBLIC_DEMO=true
# COUPONS_DEMO_RESET_ON_STARTUP=true
# SPRING_JPA_HIBERNATE_DDL_AUTO=create
#
# Also configure:
# SPRING_DATASOURCE_URL
# SPRING_DATASOURCE_USERNAME
# SPRING_DATASOURCE_PASSWORD
# COUPONS_JWT_SECRET_BASE64
# COUPONS_ALLOWED_ORIGINS
#
# IMPORTANT:
# Public demo reset destroys and recreates database tables
# every time the Spring Boot application starts.
# Use an isolated, disposable PostgreSQL database only.
# Do not use real customer data.
#
# Keep COUPONS_PUBLIC_DEMO and
# COUPONS_DEMO_RESET_ON_STARTUP unset or false
# in normal development and persistent environments.
